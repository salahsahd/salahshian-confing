proxy-groups:
  # 1. گروه هوش مصنوعی (تست سریع‌ترین سرور برای AI)
  - name: "🤖 AI (Auto)"
    type: url-test
    url: "https://chatgpt.com"
    interval: 300
    tolerance: 50
    proxies:
      - "US-AI-1"
      - "US-AI-2"
      - "US-AI-4"
      - "US-AI-5"
      - "US-Web-12"
      - "GB-Web-1"
      - "DE-Stable-1"

  # 2. گروه عمومی (برای وبگردی، یوتیوب، اینستاگرام)
  - name: "🚀 انتخاب خودکار (همه کارها)"
    type: url-test
    url: "http://www.gstatic.com/generate_204"
    interval: 300
    tolerance: 50
    proxies:
      - "US-AI-1"
      - "US-AI-2"
      - "US-AI-4"
      - "US-AI-5"
      - "US-Web-12"
      - "US-Trojan-13"
      - "GB-Web-1"
      - "GB-Web-4"
      - "DE-Stable-1"

  # 3. انتخاب دستی (اگر خواستی خودت یه سرور خاص رو انتخاب کنی)
  - name: "🎯 انتخاب دستی"
    type: select
    proxies:
      - "🚀 انتخاب خودکار (همه کارها)"
      - "🤖 AI (Auto)"
      - "US-AI-1"
      - "US-AI-2"
      - "US-AI-4"
      - "US-AI-5"
      - "US-Web-12"
      - "US-Trojan-13"
      - "GB-Web-1"
      - "GB-Web-4"
      - "DE-Stable-1"
      - "DIRECT"

rules:
  # شبکه‌های داخلی و لوکال
  - IP-CIDR,127.0.0.0/8,DIRECT
  - IP-CIDR,192.168.0.0/16,DIRECT
  - IP-CIDR,10.0.0.0/8,DIRECT

  # سایت‌های ایرانی مستقیم باز شوند
  - DOMAIN-SUFFIX,ir,DIRECT
  - GEOIP,IR,DIRECT

  # هدایت هوشمند سایت‌های هوش مصنوعی به گروه اختصاصی AI
  - DOMAIN-SUFFIX,openai.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,chatgpt.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,anthropic.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,claude.ai,🤖 AI (Auto)
  - DOMAIN-SUFFIX,gemini.google.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,bard.google.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,deepseek.com,🤖 AI (Auto)
  - DOMAIN-SUFFIX,perplexity.ai,🤖 AI (Auto)
  - DOMAIN-SUFFIX,copilot.microsoft.com,🤖 AI (Auto)

  # بقیه ترافیک‌ها از گروه عمومی رد شوند
  - MATCH,🚀 انتخاب خودکار (همه کارها)
